<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <!-- ParentName resolves against Name=, which these weapons do not have. Patches run before inheritance.
       A base that is missing takes our variants with it, instead of leaving them without a parent. -->
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[defName="BS_GiantMedievalHammer"]</xpath>
    <match Class="PatchOperationAttributeAdd">
      <xpath>Defs/ThingDef[defName="BS_GiantMedievalHammer"]</xpath>
      <attribute>Name</attribute>
      <value>BS_GiantMedievalHammer</value>
    </match>
    <nomatch Class="PatchOperationRemove">
      <xpath>Defs/ThingDef[defName="BS_GiantMedievalHammer_Unique" or defName="BS_GiantMedievalHammerBladelink"]</xpath>
    </nomatch>
  </Operation>

